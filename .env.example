VITE_CLOUDINARY_CLOUD_NAME=
VITE_SHEET_BASE_URL=
VITE_CONFIG_GID=
VITE_PRODUCTS_GID=
VITE_EVENTS_GID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Proveedores de pago externos (opcional; requerida solo si se habilita "external")
VITE_PAYMENT_API_KEY=

# Proveedor de envío externo (opcional; requerida solo si se habilita "external")
VITE_SHIPPING_API_KEY=

# Variables de SERVIDOR (se configuran en Vercel, NUNCA en el navegador):
# MERCADOPAGO_ACCESS_TOKEN             # token privado de Mercado Pago
# API_ACCESS_KEY                       # opcional: clave que el frontend envía como Bearer
# SITE_URL                             # https://tu-sitio.vercel.app (sin barra final)
# SHIPPING_CARRIER                     # ej: "Correo", "Andreani"
# SHIPPING_ZONES                       # JSON de zonas por CP (respaldo si no viene de la planilla)
# SHIPPING_FLAT_RATE                   # costo base de envío estándar
# SHIPPING_EXPRESS_SURCHARGE           # recargo del envío express
# SHIPPING_FREE_OVER                   # subtotal a partir del cual el envío es gratis
# SHIPPING_ETA                         # ej: "2 a 5 días hábiles"
# SHIPPING_EXPRESS_ETA                 # ej: "1 a 2 días hábiles"
# SHIPPING_PROVIDER_API_URL            # opcional: API real de logística
# SHIPPING_PROVIDER_API_KEY            # opcional: clave del proveedor de logística
# KV_REST_API_URL                      # para guardar órdenes (Vercel KV / Upstash Redis)
# KV_REST_API_TOKEN